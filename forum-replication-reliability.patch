+func TestFetchParallelismAndDiscoveryBudget(t *testing.T) {
+	author := open(t)
+	_, err := author.Init()
+	must(t, err)
+	pub, err := author.NewPublication("", "Notes", "", nil)
+	must(t, err)
+	public := web.NewPublic(author)
+	var active, peak, requests atomic.Int32
+	started := make(chan struct{}, 100)
+	release := make(chan struct{})
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n := active.Add(1)
+		defer active.Add(-1)
+		for p := peak.Load(); n > p && !peak.CompareAndSwap(p, n); p = peak.Load() {
+		}
+		requests.Add(1)
+		started <- struct{}{}
+		select {
+		case <-release:
+		case <-r.Context().Done():
+			return
+		}
+		// Each path prefix simulates a separate location carrying the same head.
+		r.URL.Path = r.URL.Path[strings.Index(r.URL.Path[1:], "/")+1:]
+		public.ServeHTTP(w, r)
+	}))
+	defer s.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	reader := open(t)
+	var locations []string
+	for i := 0; i < 70; i++ {
+		locations = append(locations, fmt.Sprintf("%s/copy%d", s.URL, i))
+	}
+	type result struct {
+		r    *node.FetchResult
+		errs []error
+	}
+	done := make(chan result, 1)
+	go func() {
+		r, errs := reader.Fetch(ctx, pub, locations...)
+		done <- result{r, errs}
+	}()
+	for i := 0; i < 4; i++ {
+		select {
+		case <-started:
+		case <-ctx.Done():
+			t.Fatal("fetch did not start four locations concurrently")
+		}
+	}
+	if requests.Load() != 4 {
+		t.Fatalf("started %d requests before a worker was released", requests.Load())
+	}
+	close(release)
+	var got result
+	select {
+	case got = <-done:
+	case <-ctx.Done():
+		t.Fatal("fetch did not finish")
+	}
+	if got.r == nil || got.r.Failure != nil || got.r.Unchanged || len(got.errs) != 1 || !strings.Contains(got.errs[0].Error(), "limited to 64") {
+		t.Fatalf("budget result: %+v %v", got.r, got.errs)
+	}
+	if requests.Load() != 64 || peak.Load() > 4 || active.Load() != 0 {
+		t.Fatalf("requests=%d peak=%d active=%d", requests.Load(), peak.Load(), active.Load())
+	}
+}
