+package e2e
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/Pnakotic-Codebase/forum.p2p/addr"
+	"github.com/Pnakotic-Codebase/forum.p2p/node"
+	"github.com/Pnakotic-Codebase/forum.p2p/obj"
+	"github.com/Pnakotic-Codebase/forum.p2p/web"
+)
+
+func TestSlowFetchCannotOverwriteConcurrentUpdate(t *testing.T) {
+	author := open(t)
+	_, err := author.Init()
+	must(t, err)
+	pub, err := author.NewPublication("", "Notes", "", nil)
+	must(t, err)
+	doc, err := author.Publish(pub, node.Draft{Kind: obj.Post, Title: "Post", Body: "old"})
+	must(t, err)
+	old := snapshot(t, author, pub)
+	started, release := make(chan struct{}), make(chan struct{})
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	public := web.NewPublic(old)
+	slow := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.Contains(r.URL.Path, "/revision/") {
+			close(started)
+			select {
+			case <-release:
+			case <-r.Context().Done():
+				return
+			}
+		}
+		public.ServeHTTP(w, r)
+	}))
+	defer slow.Close()
+	_, err = author.Publish(pub, node.Draft{Document: doc.String(), Title: "Post", Body: "new"})
+	must(t, err)
+	reader := open(t)
+	// Two independent Store connections exercise the database boundary.
+	other, err := node.Open(reader.Dir)
+	must(t, err)
+	defer other.Close()
+	done := make(chan *node.FetchResult, 1)
+	go func() {
+		r, _ := other.FetchFrom(ctx, pub, slow.URL)
+		done <- r
+	}()
+	select {
+	case <-started:
+	case <-ctx.Done():
+		t.Fatal("slow fetch never reached its revision")
+	}
+	newURL := host(t, author).URL
+	r, err := reader.FetchFrom(ctx, pub, newURL)
+	must(t, err)
+	if r == nil || r.Failure != nil {
+		t.Fatalf("new fetch: %+v", r)
+	}
+	close(release)
+	select {
+	case r = <-done:
+	case <-ctx.Done():
+		t.Fatal("slow fetch did not finish")
+	}
+	if r == nil || r.Failure == nil || r.Failure.Check != "head sequence" {
+		t.Fatalf("late rollback was accepted: %+v", r)
+	}
+	want, err := author.Store.HeadEnv(pub)
+	must(t, err)
+	got, err := reader.Store.HeadEnv(pub)
+	must(t, err)
+	if !bytes.Equal(got, want) {
+		t.Fatal("late old head replaced the new head")
+	}
+	events, err := reader.Store.Events(10)
+	must(t, err)
+	found := false
+	for _, e := range events {
+		if e.Location == slow.URL {
+			found = true
+			if e.Verified {
+				t.Fatal("rejected concurrent rollback logged as verified")
+			}
+		}
+	}
+	if !found {
+		t.Fatal("rejected concurrent rollback was not logged")
+	}
+}
+
+func TestFetchCancellationDrainsWorkers(t *testing.T) {
+	started, stopped := make(chan struct{}, 10), make(chan struct{}, 10)
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		started <- struct{}{}
+		<-r.Context().Done()
+		stopped <- struct{}{}
+	}))
+	defer s.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	deadline := time.After(5 * time.Second)
+	reader := open(t)
+	pub, err := addr.Parse(strings.Repeat("0", addr.Length))
+	must(t, err)
+	var locations []string
+	for i := 0; i < 10; i++ {
+		locations = append(locations, fmt.Sprintf("%s/copy%d", s.URL, i))
+	}
+	done := make(chan []error, 1)
+	go func() { _, errs := reader.Fetch(ctx, pub, locations...); done <- errs }()
+	for i := 0; i < 4; i++ {
+		select {
+		case <-started:
+		case <-deadline:
+			t.Fatal("workers did not start")
+		}
+	}
+	cancel()
+	select {
+	case errs := <-done:
+		found := false
+		for _, err := range errs {
+			found = found || errors.Is(err, context.Canceled)
+		}
+		if !found {
+			t.Fatalf("cancellation not reported: %v", errs)
+		}
+	case <-deadline:
+		t.Fatal("fetch did not cancel")
+	}
+	for i := 0; i < 4; i++ {
+		select {
