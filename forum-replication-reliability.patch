+package main
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Pnakotic-Codebase/forum.p2p/node"
+	"github.com/Pnakotic-Codebase/forum.p2p/web"
+)
+
+func TestCLIReplicationProcess(t *testing.T) {
+	if os.Getenv("FORUM_CLI_TEST") != "1" {
+		return
+	}
+	for i, a := range os.Args {
+		if a == "--" {
+			os.Args = append([]string{"forum"}, os.Args[i+1:]...)
+			main()
+			os.Exit(0)
+		}
+	}
+	os.Exit(99)
+}
+
+func TestSyncExitStatusAndWarnings(t *testing.T) {
+	author, err := node.Open(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer author.Close()
+	if _, err := author.Init(); err != nil {
+		t.Fatal(err)
+	}
+	down := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Error(w, "offline", http.StatusServiceUnavailable)
+	}))
+	defer down.Close()
+	pub, err := author.NewPublication("", "Notes", "", []string{down.URL})
+	if err != nil {
+		t.Fatal(err)
+	}
+	up := httptest.NewServer(web.NewPublic(author))
+	defer up.Close()
+	dir := t.TempDir()
+	run := func(args ...string) (string, int) {
+		t.Helper()
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		argv := append([]string{"-test.run=^TestCLIReplicationProcess$", "--", "--home", dir}, args...)
+		cmd := exec.CommandContext(ctx, os.Args[0], argv...)
+		cmd.Env = append(os.Environ(), "FORUM_CLI_TEST=1")
+		out, err := cmd.CombinedOutput()
+		if err == nil {
+			return string(out), 0
+		}
+		if e, ok := err.(*exec.ExitError); ok {
+			return string(out), e.ExitCode()
+		}
+		t.Fatal(err)
+		return "", -1
+	}
+	out, code := run("follow", "forum://"+pub.String(), "--from", up.URL)
+	if code != 0 || !strings.Contains(out, "503") || !strings.Contains(out, "verified and stored") {
+		t.Fatalf("follow code=%d output=%s", code, out)
+	}
+	out, code = run("sync")
+	if code != 0 || !strings.Contains(out, "503") || !strings.Contains(out, "unchanged") {
+		t.Fatalf("partial sync code=%d output=%s", code, out)
+	}
+	up.Close()
+	out, code = run("sync")
+	if code != 2 || !strings.Contains(out, "could not be fetched") {
+		t.Fatalf("failed sync code=%d output=%s", code, out)
+	}
+}
