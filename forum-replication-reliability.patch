--- a/store/store.go
+++ b/store/store.go
@@ -111,6 +111,25 @@ func (s *Store) Save(p *verify.Publication, source string) error {
 	}
 	defer tx.Rollback()
 	a := p.Address.String()
+	// Take SQLite's writer lock before reading the held head. This serializes the
+	// check and replacement across Store instances and processes, not just goroutines.
+	if _, err := tx.Exec(`UPDATE publications SET address=address WHERE address=?`, a); err != nil {
+		return err
+	}
+	var held verify.Held
+	var seq int64
+	err = tx.QueryRow(`SELECT public_key, sequence, head_object FROM publications WHERE address=?`, a).
+		Scan(&held.PublicKey, &seq, &held.HeadBytes)
+	var previous *verify.Held
+	if err == nil {
+		held.Sequence = uint64(seq)
+		previous = &held
+	} else if !errors.Is(err, sql.ErrNoRows) {
+		return err
+	}
+	if _, _, f := verify.Head(p.Address, p.HeadEnv, previous); f != nil {
+		return f
+	}
 	if _, err := tx.Exec(`INSERT INTO publications(address, public_key, sequence, head_object, head_env, source, verified_at)
 		VALUES(?,?,?,?,?,?,?)
 		ON CONFLICT(address) DO UPDATE SET public_key=excluded.public_key, sequence=excluded.sequence,
@@ -154,6 +173,12 @@ func (s *Store) HeadEnv(a addr.ID) ([]byte, error) {
 	return s.blob(`SELECT head_env FROM publications WHERE address = ?`, a.String())
 }
 
+func (s *Store) Source(a addr.ID) (string, error) {
+	var source string
+	err := s.db.QueryRow(`SELECT source FROM publications WHERE address=?`, a.String()).Scan(&source)
+	return source, err
+}
+
 func (s *Store) Revision(id digest.Digest) ([]byte, error) {
 	return s.blob(`SELECT env FROM revisions WHERE id = ?`, id[:])
 }
