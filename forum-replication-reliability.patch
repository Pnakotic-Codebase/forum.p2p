+package e2e
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/Pnakotic-Codebase/forum.p2p/addr"
+	"github.com/Pnakotic-Codebase/forum.p2p/node"
+	"github.com/Pnakotic-Codebase/forum.p2p/obj"
+	"github.com/Pnakotic-Codebase/forum.p2p/web"
+)
+
+func snapshot(t *testing.T, author *node.Node, pub addr.ID) *node.Node {
+	t.Helper()
+	b, err := author.Export(pub)
+	must(t, err)
+	n := open(t)
+	if _, f, err := n.Import(b, "snapshot"); err != nil || f != nil {
+		t.Fatalf("snapshot: %v %v", f, err)
+	}
+	return n
+}
+
+func TestFetchNewestReplica(t *testing.T) {
+	author := open(t)
+	words, err := author.Init()
+	must(t, err)
+	pub, err := author.NewPublication("", "Notes", "", nil)
+	must(t, err)
+	doc, err := author.Publish(pub, node.Draft{Kind: obj.Post, Title: "Post", Body: "old"})
+	must(t, err)
+	old := snapshot(t, author, pub)
+	oldURL := host(t, old).URL
+	_, err = author.Publish(pub, node.Draft{Document: doc.String(), Title: "Post", Body: "middle"})
+	must(t, err)
+	middle := snapshot(t, author, pub)
+	middleURL := host(t, middle).URL
+
+	// A second writer with the same key creates a different head at the same sequence.
+	fork := snapshot(t, author, pub)
+	must(t, fork.Restore(strings.Join(words, " ")))
+	_, err = fork.Adopt("", 0)
+	must(t, err)
+	_, err = fork.Publish(pub, node.Draft{Document: doc.String(), Title: "Fork", Body: "conflicting"})
+	must(t, err)
+	forkURL := host(t, fork).URL
+
+	_, err = author.Publish(pub, node.Draft{Document: doc.String(), Title: "Post", Body: "newest"})
+	must(t, err)
+	newURL := host(t, author).URL
+	newHead, err := author.Store.HeadEnv(pub)
+	must(t, err)
+	bad := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasSuffix(r.URL.Path, "/head") {
+			w.Write(newHead)
+			return
+		}
+		w.Write([]byte("corrupt revision"))
+	}))
+	defer bad.Close()
+	down := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Error(w, "unavailable", http.StatusServiceUnavailable)
+	}))
+	defer down.Close()
+
+	for _, tc := range []struct {
+		name      string
+		from      []string
+		want      *node.Node
+		location  string
+		wantError bool
+	}{
+		{"old then middle then new", []string{oldURL, middleURL, newURL}, author, newURL, false},
+		{"new then old", []string{newURL, oldURL}, author, newURL, true},
+		{"new then same", []string{newURL, host(t, author).URL}, author, newURL, false},
+		{"unavailable then new", []string{down.URL, newURL}, author, newURL, true},
+		{"new then unavailable", []string{newURL, down.URL}, author, newURL, true},
+		{"corrupt newest then middle", []string{bad.URL, middleURL}, middle, middleURL, true},
+		{"new then conflicting", []string{newURL, forkURL}, author, newURL, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			reader := open(t)
+			r, errs := reader.Fetch(context.Background(), pub, tc.from...)
+			if r == nil || r.Failure != nil {
+				t.Fatalf("fetch failed: %+v %v", r, errs)
+			}
+			if (len(errs) > 0) != tc.wantError {
+				t.Fatalf("errors: %v, want errors: %v", errs, tc.wantError)
+			}
+			want, err := tc.want.Store.HeadEnv(pub)
+			must(t, err)
+			got, err := reader.Store.HeadEnv(pub)
+			must(t, err)
+			if !bytes.Equal(got, want) || !bytes.Equal(r.Publication.HeadEnv, want) || r.Location != tc.location || r.Unchanged {
+				t.Fatalf("wrong result or stored head: location=%s unchanged=%v sequence=%d", r.Location, r.Unchanged, r.Publication.Head.Sequence)
+			}
+		})
+	}
+}
+
+func TestFollowAndSyncDiscoverCopies(t *testing.T) {
+	author := open(t)
+	_, err := author.Init()
+	must(t, err)
+	stale := open(t)
+	staleHost := host(t, stale)
+	var heads atomic.Int32
+	public := web.NewPublic(author)
+	current := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasSuffix(r.URL.Path, "/head") {
+			heads.Add(1)
+		}
+		public.ServeHTTP(w, r)
+	}))
+	defer current.Close()
+	pub, err := author.NewPublication("", "Notes", "", []string{current.URL, " " + current.URL + "/ ", staleHost.URL})
+	must(t, err)
+	doc, err := author.Publish(pub, node.Draft{Kind: obj.Post, Title: "Post", Body: "old"})
+	must(t, err)
+	res, err := stale.FetchFrom(context.Background(), pub, current.URL)
+	must(t, err)
+	if res.Failure != nil {
+		t.Fatal(res.Failure)
+	}
+	_, err = author.Publish(pub, node.Draft{Document: doc.String(), Title: "Post", Body: "new"})
+	must(t, err)
+	heads.Store(0)
+	reader := open(t)
+	r, errs := reader.Follow(context.Background(), pub, staleHost.URL)
+	if r == nil || r.Failure != nil || r.Publication.Head.Sequence != 3 || r.Unchanged || len(errs) != 0 || heads.Load() != 1 {
+		t.Fatalf("follow missed newly discovered copy or fetched it repeatedly: %+v %v heads=%d", r, errs, heads.Load())
+	}
+	_, err = author.Publish(pub, node.Draft{Document: doc.String(), Title: "Post", Body: "newer"})
+	must(t, err)
+	reports, err := reader.Sync(context.Background())
+	must(t, err)
+	if len(reports) != 1 || reports[0].Result == nil || reports[0].Result.Failure != nil || reports[0].Result.Publication.Head.Sequence != 4 || reports[0].Result.Unchanged {
+		t.Fatalf("sync stopped at stale origin: %+v", reports)
+	}
+	r, _ = reader.Fetch(context.Background(), pub, current.URL)
+	if r == nil || r.Failure != nil || !r.Unchanged {
+		t.Fatalf("unchanged fetch: %+v", r)
+	}
+}
+
+func TestFetchWithoutSuccessfulReplica(t *testing.T) {
+	reader := open(t)
+	pub, err := addr.Parse(strings.Repeat("0", addr.Length))
+	must(t, err)
+	r, errs := reader.Fetch(context.Background(), pub)
+	if r != nil || len(errs) != 1 || !strings.Contains(errs[0].Error(), "no location known") {
+		t.Fatalf("no locations: %+v %v", r, errs)
+	}
+	bad := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.Write([]byte("bad")) }))
+	defer bad.Close()
+	r, errs = reader.Fetch(context.Background(), pub, bad.URL)
+	if r == nil || r.Failure == nil || len(errs) != 1 {
+		t.Fatalf("invalid replica: %+v %v", r, errs)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	r, errs = reader.Fetch(ctx, pub, bad.URL, bad.URL+"/other")
+	if r != nil || len(errs) != 1 || !errors.Is(errs[0], context.Canceled) {
+		t.Fatalf("cancellation: %+v %v", r, errs)
+	}
+}
